{
  "name": "megadungeon",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based megadungeon roguelike in TypeScript with a classic CP437 text interface.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "content:check": "tsx tools/content-build.ts --check",
    "content:build": "tsx tools/content-build.ts",
    "content:report": "tsx tools/content-build.ts --report",
    "content:strict": "tsx tools/content-build.ts --check --strict",
    "typecheck": "npm run content:build && tsc --noEmit",
    "test": "vitest run",
    "dev": "npm run content:build && vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "ci": "npm run content:check && npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstevenson1237/megadungeon.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
