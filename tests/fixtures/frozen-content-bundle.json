rs":[{"id":"stub_rumour_vault","needs":"vault","text":["They say a sealed vault waits on level {level}, and only its own key will open it.","A drunk miner swore he saw a vault door on level {level}."]},{"id":"stub_rumour_boss","needs":"boss","text":["{Boss} holds level {level}.","Something on level {level} guards {artifact}."]},{"id":"stub_rumour_teleporter","needs":"teleporter","text":["There is a teleporter on level {level}."]},{"id":"stub_rumour_rival_stash","needs":"rival_stash","text":["{Rival} hid a stash on level {level}."]},{"id":"stub_rumour_trap_level","needs":"trap_level","text":["Level {level} is thick with traps."]},{"id":"stub_rumour_fountain","needs":"fountain","text":["There is a fountain on level {level}."]}],"signs":[{"id":"sign_stub_01","text":"Stairs down. Mind the dark."},{"id":"sign_stub_02","text":"Authorised delvers only."},{"id":"sign_stub_03","text":"Deep hall, this way."}],"vault_names":[{"id":"vault_name_stub_01","name":"the Sunken Strongroom"},{"id":"vault_name_stub_02","name":"the Miser's Cell"},{"id":"vault_name_stub_03","name":"the Last Treasury"}],"spells":[{"id":"heal","name":"Heal","shape":"self","effect":"restore_die","text":"Restore one Combat die."},{"id":"shield","name":"Shield","shape":"self","effect":"shield","text":"Ignore the next hit taken within 10 rounds.","rounds":10},{"id":"haste","name":"Haste","shape":"self","effect":"status","text":"Act twice per round for 3 rounds.","status":"hasted","rounds":3},{"id":"light","name":"Light","shape":"self","effect":"light","text":"Light the current room or 8 cells around you, revealing it.","reach":8},{"id":"detect","name":"Detect","shape":"self","effect":"detect","text":"Reveal traps and secret doors within 8 cells.","reach":8},{"id":"blink","name":"Blink","shape":"self","effect":"blink","text":"Move instantly to a visible cell within 5 cells.","reach":5},{"id":"arcane_bolt","name":"Arcane Bolt","shape":"target","effect":"remove_die","text":"Remove one die from the target.","reach"